{
  "name": "@shieldlabs-ai/node",
  "version": "1.0.1",
  "description": "ShieldLabs server SDK for Node.js and edge runtimes: History API and Management API clients, webhook signature verification, typed identifications and risk helpers.",
  "license": "MIT",
  "author": "ShieldLabs Inc. <contact@shieldlabs.ai>",
  "homepage": "https://docs.shieldlabs.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShieldLabs-ai/shieldlabs-node.git"
  },
  "bugs": {
    "url": "https://github.com/ShieldLabs-ai/shieldlabs-node/issues",
    "email": "contact@shieldlabs.ai"
  },
  "keywords": [
    "shieldlabs",
    "device-intelligence",
    "risk-score",
    "fraud-prevention",
    "bot-detection",
    "webhooks",
    "server-sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "deno": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/edge.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/edge.cjs"
        }
      },
      "workerd": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/edge.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/edge.cjs"
        }
      },
      "worker": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/edge.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/edge.cjs"
        }
      },
      "edge-light": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/edge.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/edge.cjs"
        }
      },
      "browser": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/edge.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/edge.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:package": "node scripts/check-package.mjs",
    "test:runtime": "node test/runtime/smoke.mjs && node --conditions=worker test/runtime/smoke.mjs",
    "test:example": "node scripts/smoke-example.mjs",
    "sync": "./sync.sh",
    "generate": "node generate.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
